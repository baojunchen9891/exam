":"B","content":[{"t":"B：3"}]},{"key":"C","content":[{"t":"C：6"}]},{"key":"D","content":[{"t":"D：9"}]}],"answer":"C","analysis":"","auto":true},{"no":12,"type":"单选题","stem":[{"t":"程序 Serial.print(12,8); 运行后，串口监视器显示的结果是？（ ）"}],"options":[{"key":"A","content":[{"t":"A：C"}]},{"key":"B","content":[{"t":"B：8"}]},{"key":"C","content":[{"t":"C：12"}]},{"key":"D","content":[{"t":"D：14"}]}],"answer":"D","analysis":"程序 Serial.print(12, 8); 运行后，串口监视器显示的结果是 00000012。 在Arduino编程中，Serial.print()函数用于将数据发送到串口监视器。当使用两个参数时，第一个参数是要打印的值，第二个参数是指定打印格式的基数（进制）。在这个例子中，12是要打印的数值，8表示以八进制（base-8）格式打印。因此，十进制数12转换为八进制就是14，但由于前面补足了零以达到固定的位数，所以显示为00000014。","auto":true},{"no":13,"type":"单选题","stem":[{"t":"ESP32 for Arduino，程序Serial.printf()中格式字符“%x”的含义是？（ ）"}],"options":[{"key":"A","content":[{"t":"A：表示八进制整数输出"}]},{"key":"B","content":[{"t":"B：表示十进制整数输出"}]},{"key":"C","content":[{"t":"C：表示十六进制整数输出"}]},{"key":"D","content":[{"t":"D：表示单个字符输出"}]}],"answer":"C","analysis":"","auto":true},{"no":14,"type":"单选题","stem":[{"t":"ESP32主控芯片中，具有8通道模拟输出的外设是？（ ）"}],"options":[{"key":"A","content":[{"t":"A：LEDC"}]},{"key":"B","content":[{"t":"B：SigmaDelta"}]},{"key":"C","content":[{"t":"C：DAC"}]},{"key":"D","content":[{"t":"D：ADC"}]}],"answer":"B","analysis":"","auto":true},{"no":15,"type":"单选题","stem":[{"t":"电路搭设和对应的程序如下，当按键开关按下后，LED灯点亮，程序中A和B分别为？（ ）"},{"img":"https://www.leledati.com/files/attach/files/content/20241026/17299264115906.png"}],"options":[{"key":"A","content":[{"t":"A：pinMode(12,INPUT_PULLUP); / val == HIGH"}]},{"key":"B","content":[{"t":"B：pinMode(12,INPUT_PULLUP); / val == LOW"}]},{"key":"C","content":[{"t":"C：pinMode(12,INPUT_PULLDOWN); / val == HIGH"}]},{"key":"D","content":[{"t":"D：pinMode(12,INPUT_PULLDOWN); / val == LOW"}]}],"answer":"A","analysis":"","auto":true},{"no":16,"type":"单选题","stem":[{"t":"74HC595移位寄存器芯片的引脚中，下列选项中，关于引脚ST_CP描述正确的是？（ ）"}],"options":[{"key":"A","content":[{"t":"A：并行数据输出引脚"}]},{"key":"B","content":[{"t":"B：输出锁存时钟引脚"}]},{"key":"C","content":[{"t":"C：数据输入时钟引脚"}]},{"key":"