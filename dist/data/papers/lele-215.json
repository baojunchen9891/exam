push 4"},{"t":"min"},{"t":"样例输出"},{"t":"2"},{"t":"2"}],"options":[],"answer":null,"analysis":"","auto":false},{"no":4,"type":"问答题","stem":[{"t":"重建二叉树"},{"t":"给定一棵二叉树的前序遍历和中序遍历的结果，求其后序遍历。"},{"t":"时间限制：1000"},{"t":"内存限制：65536"},{"t":"输入"},{"t":"输入可能有多组，以EOF结束。 每组输入包含两个字符串，分别为树的前序遍历和中序遍历。每个字符串中只包含大写字母且互不重复。"},{"t":"输出"},{"t":"对于每组输入，用一行来输出它后序遍历结果。"},{"t":"样例输入"},{"t":"DBACEGF ABCDEFG"},{"t":"BCAD CBAD"},{"t":"样例输出"},{"t":"ACBFGED"},{"t":"CDAB"}],"options":[],"answer":null,"analysis":"","auto":false}],"durationMin":60,"totalScore":100,"passScore":60,"source":"leledati","tags":{"year":"2022","type":"真题","progress":"未开始"}}