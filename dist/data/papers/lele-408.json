":"https://www.leledati.com/files/attach/files/content/20240125/17061515339089.png"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"B","analysis":"","auto":true},{"no":6,"type":"判断题","stem":[{"t":"贪心算法可以达到局部最优，但可能不是全局最优解。 (   )"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"A","analysis":"","auto":true},{"no":7,"type":"判断题","stem":[{"t":"如果自定已class已经定义了 __lt__() 魔术方法，则自动支持内置函数 sorted() 。（   ）"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"A","analysis":"","auto":true},{"no":8,"type":"判断题","stem":[{"t":"插入排序有时比快速排序时间复杂度更低。（   ）"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"A","analysis":"","auto":true},{"no":9,"type":"判断题","stem":[{"t":"下面的Python代码能实现十进制正整数N转换为八进制并输出。（   ）"},{"img":"https://www.leledati.com/files/attach/files/content/20240125/17061516727756.png"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"B","analysis":"","auto":true},{"no":10,"type":"判断题","stem":[{"t":"Python代码 print(sorted(list(range(10)), key = lambda x:x % 5)) 执行后将输出 [0, 5, 1,6, 2, 7, 3, 8, 4, 9] 。（   ）"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"A","analysis":"","auto":true},{"no":1,"type":"问答题","stem":[{"t":"小杨的幸运数"},{"t":"时间限制：5.0 s"},{"t":"内存限制：128.0 MB"},{"t":"问题描述"},{"t":"小杨认为，所有大于等于a的完全平方数都是他的超级幸运数。"},{"t":"小杨还认为，所有超级幸运数的倍数都是他的幸运数。自然地，小杨的所有超级幸运数也都是幸运数。"},{"t":"对于一个非幸运数，小杨规定，可以将它一直+1，直到它变成一个幸运数。我们把这个过程叫做幸运化。例如，如果a=4，那么4是最小的幸运数，而1不是，但我们可以连续对1做3次+1操作，使其变为4，所以我们可以说，1幸运化后的结果是4。"},{"t":"现在，小样给出N个数，请你首先判断它们是不是幸运数；接着，对于非幸运数，请你将它们幸运化。"},{"t":"输入描述"},{"t":"第一行 2 个正整数a,N。"},{"t":"接下来N行，每行一个正整数x，表示需要判断（幸运化）的数。"},{"t":"输出描述"},{"t":"输出N行，对于每个给定的x，如果它是幸运数，请输出lucky ，否则请输出将其幸运化后的结果。"},{"t":"特别提醒"},{"t":"在常规程序中，输入、输出时提供提示是好习惯。但在本场考试中，由于系统限定，请不要在输入、输出中附带任何提示信息。"},{"t":"样例输入 1"},{"t":"2 4\r\n1\r\n4\r\n5\r\n9"},{"t":"样例输出 1"},{"t":"4\r\nlucky\r\n8\r\nlucky"},{"t":"样例解释 1"},{"t":"1虽然是完全平方数，但它小于a，因此它并不是超级幸运数，也不是幸运数。将其进行3次+1操作后，最终得到幸运数4。"},{"t":"4是幸运数，因此直接输出 lucky 。"},{"t":"5不是幸运数，将其进行3次+1操作后，最终得到幸运数8。"},{"t":"9是幸运数，因此直接输出 lucky 。"},{"t":"样例输入 2"},{"t":"16 11\r\n1\r\n2\r\n4\r\n8\r\n16\r\n32\r\n64\r\n128\r\n256\r\n512\r\n1024"},{"t":"样例输出 2"},{"t":"16\r\n16\r\n16\r\n16\r\nlucky\r\nlucky\r\nlucky\r\nlucky\r\nlucky\r\nlucky\r\nlucky"},{"t":"数据规模"},{"t":"对于30%的测试点，保证a,x≤100，N≤100 。"},{"t":"对于60%的测试点，保证a,x≤106。"},{"t":"对于所有测试点，保证a≤1000001；保证N≤2×105；保证1≤x≤1000001。"}],"options":[],"answer":null,"analysis":"","auto":false},{"no":2,"type":"问答题","stem":[{"t":"烹饪问题"},{"t":"时间限制：1.0 s"},{"t":"内存限制：128.0 MB"},{"t":"问题描述"},{"t":"有N种食材，编号从0至N-1，其中第i种食材的美味度为ai。"},{"t":"不同食材之间的组合可能产生奇妙的化学反应。具体来说，如果两种食材的美味度分别为x和y，那么它们的契合度为x and y。"},{"t":"其中，and运算为按位与运算，需要先将两个运算数转换为二进制，然后在高位补足0，再逐位进行与运算。例如，12与6的二进制表示分别为 1100 和 0110 ，将它们逐位进行与运算，得到 0100 ，转换为十进制得到4，因此12 and 6=4。在 C++ 或 Python 中，可以直接使用 & 运算符表示与运算。"},{"t":"现在，请你找到契合度最高的两种食材，并输出它们的契合度。"},{"t":"输入描述"},{"t":"第一行一个整数N，表示食材的种数。"},{"t":"接下来一行N个用空格隔开的整数，依次为a0,…，aN-1，表示各种食材的美味度。"},{"t":"输出描述"},{"t":"输出一行一个整数，表示最高的契合度。"},{"t":"特别提醒"},{"t":"在常规程序中，输入、输出时提供提示是好习惯。但在本场考试中，由于系统限定，请不要在输入、输出中附带任何提示信息。"},{"t":"样例输入 1"},{"t":"3\r\n1 2 3"},{"t":"样例输出 1"},{"t":"2"},{"t":"样例解释 1"},{"t":"可以编号为1,2的食材之间的契合度为2 and 3=2，是所有食材两两之间最高的契合度。"},{"t":"样例输入 2"},{"t":"5\r\n5 6 2 10 13"},{"t":"样例输出 2"},{"t":"8"},{"t":"样例解释 1"},{"t":"可以编号为3,4的食材之间的契合度为10 and 13=8，是所有食材两两之间最高的契合度。"},{"t":"数据规模"},{"t":"对于40%的测试点，保证N≤1000；"},{"t":"对于所有测试点，保证N≤106，0≤ai≤2147483647。"}],"options":[],"answer":null,"analysis":"","auto":false}],"durationMin":60,"totalScore":100,"passScore":60,"source":"leledati","tags":{"year":"2023","type":"真题","progress":"未开始"}}