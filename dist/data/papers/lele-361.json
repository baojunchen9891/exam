5/17009023257662.png"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"B","analysis":"","auto":true},{"no":1,"type":"问答题","stem":[{"t":"自幂数判断"},{"img":"https://www.leledati.com/files/attach/files/content/20231125/17009023707219.png"},{"img":"https://www.leledati.com/files/attach/files/content/20231125/17009023828713.png"},{"t":"【题目描述】"},{"t":"自幂数是指 N 位数各位数字 N 次方之和是本身，如 153 是 3 位数，其每位数的 3 次方之和是 153 本身，因此 153 是自幂数，1634 是 4 位数，其每位数的 4 次方之和是1634 本身，因此 1634 是自幂数。（注：5 的 3 次方为 5×5×5；5 的 4 次方为 5×5×5×5。）"},{"t":"默认小猫角色，白色背景。编写程序判断一个三位的正整数是否为自幂数，如果是自幂数先输出数本身然后紧随 T，否则输出数本身然后紧随 F。"},{"t":"【输入描述】"},{"t":"新建变量“n”用于存储一个三位的正整数。"},{"t":"如下图所示："},{"img":"https://www.leledati.com/files/attach/files/content/20231125/17009024372178.png"},{"t":"【输出描述】"},{"t":"新建变量“result”用于存储判断的结果，如果是自幂数先输出数本身然后紧随 T，否则输出数本身然后紧随 F。"},{"t":"如下图所示："},{"img":"https://www.leledati.com/files/attach/files/content/20231125/17009024501915.png"},{"t":"【输入样例1】"},{"t":"n = 153"},{"t":"【输出样例1】"},{"t":"result = 153T"},{"t":"【输入样例2】"},{"t":"n = 152"},{"t":"【输出样例2】"},{"t":"result = 152F"}],"options":[],"answer":null,"analysis":"【评分标准】 一共 5 组测试用例，通过一组测试用例得 5 分。 测试用例 1：n = 370；result = 370T 测试用例 2：n = 371；result = 371T 测试用例 3：n = 407；result = 407T 测试用例 4：n = 520；result = 520F 测试用例 5：n = 876；result = 876F","auto":false},{"no":2,"type":"问答题","stem":[{"t":"计算最终值"},{"img":"https://www.leledati.com/files/attach/files/content/20231125/17009025568725.png"},{"img":"https://www.leledati.com/files/attach/files/content/20231125/17009025676371.png"},{"t":"【题目描述】"},{"t":"默认小猫角色，白色背景。存在一种仅支持 2 种操作和 1 个变量的编程语言："},{"t":"X++ 使变量 “X” 的值增加 1"},{"t":"X-- 使变量 “X” 的值减少 1"},{"t":"最初，“X”的值是 0，给你一个由操作组成的列表“lst”，需要得到执行所有操"},{"t":"作后，“X”的最终值。"},{"t":"【输入描述】"},{"t":"新建列表“lst”，存储变量“X”执行的操作，例如 lst = [“X++”,”X++”,”X--”]"},{"t":"最初，X = 0"},{"t":"X++：X 加 1，X = 0 + 1 = 1"},{"t":"X++：X 加 1，X = 1 + 1 = 2"},{"t":"X--：X 减 1，X = 2 - 1 = 1"},{"t":"如下图所示："},{"img":"https://www.leledati.com/files/attach/files/content/20231125/17009026367983.png"},{"t":"【输出描述】"},{"t":"新建变量“X”，初始值为 0，经过列表中的操作后将最终的结果存入其中。"},{"t":"如下图所示："},{"img":"https://www.leledati.com/files/attach/files/content/20231125/17009026478322.png"},{"t":"【输入样例1】"},{"t":"lst = [“X++”,”X++”,”X--”]"},{"t":"【输出样例1】"},{"t":"X = 1"},{"t":"【输入样例2】"},{"t":"lst = [“X++”,”X++”,”X++”]"},{"t":"【输出样例2】"},{"t":"X = 3"}],"options":[],"answer":null,"analysis":"【评分标准】 一共 5 组测试用例，通过一组测试用例得 5 分。 测试用例 1：lst = [“X++”,”X++”,”X--”,”X--”,”X--”]；X = -1 测试用例 2：lst = [“X++”,”X--”,”X++”,”X++”]；X = 2 测试用例 3：lst = [“X--”,”X--”,”X++”,”X--”]；X = -2 测试用例 4：lst = [”X++”,”X--”,”X--”,”X++”]；X = 0 测试用例 5：lst = [”X++”,”X++”,”X++”,”X++”]；X = 4","auto":false}],"durationMin":60,"totalScore":100,"passScore":60,"source":"leledati","tags":{"year":"2023","type":"真题","progress":"未开始"}}