g":"https://www.leledati.com/files/attach/files/content/20231121/17005400902202.png"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"B","analysis":"","auto":true},{"no":3,"type":"判断题","stem":[{"t":"默认小猫角色，执行下列代码，小猫的方向跟着鼠标改变，但位置不会发生改变。（     ）"},{"img":"https://www.leledati.com/files/attach/files/content/20231121/17005401915644.png"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"A","analysis":"","auto":true},{"no":4,"type":"判断题","stem":[{"t":"默认小猫角色，执行下列代码，小猫的音量调整为 140%。（     ）"},{"img":"https://www.leledati.com/files/attach/files/content/20231121/17005402381087.png"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"B","analysis":"","auto":true},{"no":5,"type":"判断题","stem":[{"t":"在角色中编程可以切换舞台背景，但是在舞台背景中编程无法切换角色造型。（     ）"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"A","analysis":"","auto":true},{"no":1,"type":"问答题","stem":[{"t":"跳舞"},{"img":"https://www.leledati.com/files/attach/files/content/20231121/17005403248082.png"},{"t":"准备工作："},{"t":"（1）删除默认小猫角色。"},{"t":"（2）添加角色 Ballerina,并为其添加声音 Dance Around。"},{"t":"（3）删除默认白色背景，添加背景 Spotlight。"},{"t":"功能实现（用积木块实现下列描述的功能）："},{"t":"（1）点击绿旗，角色 Ballerina 的初始位置为（X=10，Y=0），初始方向 90°，初始造型为 ballerina-a。"},{"t":"（2）点击绿旗，舞台的初始背景为 Spotlight，清除图形特效，每隔 1 秒颜色特效增加 25，一共增加 10 次。"},{"t":"（3）播放音乐 Dance Around，Ballerina 说“开始跳舞”2 秒后，开始跳舞，每隔 0.5 秒切换一次造型，一共切换 20 次。"},{"t":"（4）跳舞结束，停止播放音乐，Ballerina 说“谢谢大家”，2 秒。"},{"t":"注意："},{"t":"1. 功能（1）、（3）、（4）全部写在 ballerina 角色代码区的【当绿旗被点击】积木下面。"},{"t":"2. 功能（2）全部写在背景代码区的【当绿旗被点击】积木下面。"}],"options":[],"answer":null,"analysis":"评分标准： （1）点击绿旗，角色 Ballerina 的初始位置为（X=10，Y=0），初始方向 90°，初始造型为 ballerina-a。（一共 3 分）。 （2）点击绿旗，舞台的初始背景为 Spotlight，清除图形特效，每隔 1 秒颜色特效增加 25，一共增加 10 次。（一共 10 分） （3）播放音乐 Dance Around，Ballerina 说“开始跳舞”2 秒后，开始跳舞，每隔 0.5 秒切换一次造型，一共切换 20 次。（一共 10 分） （4）跳舞结束，停止播放音乐，Ballerina 说“谢谢大家”，2 秒。（一共 2 分）","auto":false},{"no":2,"type":"问答题","stem":[{"t":"小鸡躲球"},{"img":"https://www.leledati.com/files/attach/files/content/20231121/17005404595436.png"},{"t":"准备工作："},{"t":"（1）删除默认小猫角色。"},{"t":"（2）添加角色 Chick 和 Ball。"},{"t":"（3）删除默认白色背景，添加背景 Blue Sky。"},{"t":"功能实现（用积木块实现下列描述的功能）："},{"t":"（1）点击绿旗，小鸡角色站在地面上，初始位置为（X=-140，Y=-120），初始方向为 90°，旋转方式为任意旋转。在小鸡角色中设置舞台的初始背景为 Blue Sky。"},{"t":"（2）点击绿旗，小球角色的初始位置为（X=210，Y=-140），初始大小为 80，面向方向为-90°。"},{"t":"（3）小球从初始位置（舞台右边）水平地滚到舞台左边碰到边缘后，再移到初始位置，一直执行下去。"},{"t":"（4）按下空格键，小鸡向上跳起一段距离后，又落到地面。"},{"t":"（5）小鸡碰到小球，程序终止。"},{"t":"注意："},{"t":"1. 功能（1）、（5）全部写在 Chick 角色代码区的【当绿旗被点击】积木下面。"},{"t":"2. 功能（4）写在 Chick 角色代码区的【当按下空格键】积木下面。"},{"t":"3. 功能（2）、（3）全部写在 Ball 角色代码区的【当绿旗被点击】积木下面。"}],"options":[],"answer":null,"analysis":"评分标准： （1）点击绿旗，小鸡角色站在地面上，初始位置为（X=-140，Y=-120），初始方向为 90°，旋转方式为任意旋转。在小鸡角色中设置舞台的初始背景为 Blue Sky。（一共 4 分） （2）点击绿旗，小球角色的初始位置为（X=210，Y=-140），初始大小为 80，面向方向为-90°。（一共 3 分） （3）小球从初始位置（舞台右边）水平地滚到舞台左边碰到边缘后，再移到初始位置，一直执行下去。（一共 5 分） （4）按下空格键，小鸡向上跳起一段距离后，又落到地面。（一共 6 分） （5）小鸡碰到小球，程序终止。（一共 7 分）","auto":false}],"durationMin":60,"totalScore":100,"passScore":60,"source":"leledati","tags":{"year":"2023","type":"真题","progress":"未开始"}}