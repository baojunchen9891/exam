当然地选 B。逼近次数只有 1，很难那么准确。 6）同上一题，模拟几次即可得到选项。 7）整数平方根二分就算出来了，跟迭代都没关系。","auto":true},{"no":1,"type":"单选题（完善程序）","stem":[{"t":"完善程序（1）"},{"t":"第1-5题，组合题"},{"t":"（枚举因数）从小到大打印正整数 n 的所有正因数。"},{"t":"试补全枚举程序。"},{"t":"01 #include <bits/stdc++.h>"},{"t":"02 using namespace std;"},{"t":"03"},{"t":"04 int main() {"},{"t":"05 int n;"},{"t":"06 cin >> n;"},{"t":"07"},{"t":"08 vector<int> fac;"},{"t":"09 fac.reserve((int)ceil(sqrt(n)));"},{"t":"10"},{"t":"11 int i;"},{"t":"12 for (i = 1; i * i < n; ++i) {"},{"t":"13 if (①) {"},{"t":"14 fac.push_back(i);"},{"t":"15 }"},{"t":"16 }"},{"t":"17"},{"t":"18 for (int k = 0; k < fac.size(); ++k) {"},{"t":"19 cout << ② << \" \";"},{"t":"20 }"},{"t":"21 if (③) {"},{"t":"22 cout << ④ << \" \";"},{"t":"23 }"},{"t":"24 for (int k = fac.size() - 1; k >= 0; --k) {"},{"t":"25 cout << ⑤ << \" \";"},{"t":"26 }"},{"t":"27 }"}],"options":[{"key":"A","content":[{"t":"A：n % i == 0"}]},{"key":"B","content":[{"t":"B：n % i == 1"}]},{"key":"C","content":[{"t":"C：n % (i-1)== 0"}]},{"key":"D","content":[{"t":"D：n % (i-1) == 1"}]}],"answer":"A","analysis":"","auto":true},{"no":2,"type":"单选题（完善程序）","stem":[{"t":"②处应填（ ）"}],"options":[{"key":"A","content":[{"t":"A：n / fac[k]"}]},{"key":"B","content":[{"t":"B：fac[k]"}]},{"key":"C","content":[{"t":"C：fac[k]-1"}]},{"key":"D","content":[{"t":"D：n / (fac[k]-1)"}]}],"answer":"B","analysis":"","auto":true},{"no":3,"type":"单选题（完善程序）","stem":[{"t":"③处应填（ ）"}],"options":[{"key":"A","content":[{"t":"A：(i-1) * (i-1) == n"}]},{"key":"B","content":[{"t":"B：(i-1) * i == n"}]},{"key":"C","content":[{"t":"C：i * i == n"}]},{"key":"D","content":[{"t":"D：i * (i-1) == n"}]}],"answer":"C","analysis":"","auto":true},{"no":4,"type":"单选题（完善程序）","stem":[{"t":"④处应填（ ）"}],"options":[{"key":"A","content":[{"t":"A：n-i"}]},{"key":"B","content":[{"t":"B：n-i+1"}]},{"key":"C","content":[{"t":"C：i-1"}]},{"key":"D","content":[{"t":"D：i"}]}],"answer":"D","analysis":"","auto":true},{"no":5,"type":"单选题（完善程序）","stem":[{"t":"⑤处应填（ ）"}],"options":[{"key":