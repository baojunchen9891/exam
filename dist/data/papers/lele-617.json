"t":"42 int main() {"},{"t":"43 char image[ROWS][COLS] = {{'g', 'g', 'g', 'g', 'g', 'g', 'g', 'g'},"},{"t":"44 {'g', 'g', 'g', 'g', 'g', 'g', 'r', 'r'},"},{"t":"45 {'g', 'r', 'r', 'g', 'g', 'r', 'g', 'g'},"},{"t":"46 {'g', 'b', 'b', 'b', 'b', 'r', 'g', 'r'},"},{"t":"47 {'g', 'g', 'g', 'b', 'b', 'r', 'g', 'r'},"},{"t":"48 {'g', 'g', 'g', 'b', 'b', 'b', 'b', 'r'},"},{"t":"49 {'g', 'g', 'g', 'g', 'g', 'b', 'g', 'g'},"},{"t":"50 {'g', 'g', 'g', 'g', 'g', 'b', 'b', 'g'}};"},{"t":"51"},{"t":"52 Point cur(4, 4);"},{"t":"53 char new_color = 'y';"},{"t":"54"},{"t":"55 flood_fill(image, cur, new_color);"},{"t":"56"},{"t":"57 for (int r = 0; r < ROWS; r++) {"},{"t":"58 for (int c = 0; c < COLS; c++) {"},{"t":"59 cout << image[r][c] << \" \";"},{"t":"60 }"},{"t":"61 cout << endl;"},{"t":"62 }"},{"t":"63 // 输出："},{"t":"64 // g g g g g g g g"},{"t":"65 // g g g g g g r r"},{"t":"66 // g r r g g r g g"},{"t":"67 // g y y y y r g r"},{"t":"68 // g g g y y r g r"},{"t":"69 // g g g y y y y r"},{"t":"70 // g g g g g y g g"},{"t":"71 // g g g g g y y g"},{"t":"72"},{"t":"73 return 0;"},{"t":"74 }"}],"options":[{"key":"A","content":[{"t":"A：image[r][c] == prev_color"}]},{"key":"B","content":[{"t":"B：image[r][c] != prev_color"}]},{"key":"C","content":[{"t":"C：image[r][c] == new_color"}]},{"key":"D","content":[{"t":"D：image[r][c] != new_color"}]}],"answer":"A","analysis":"","auto":true},{"no":7,"type":"单选题（完善程序）","stem":[{"t":"②处应填（ ）"}],"options":[{"key":"A","content":[{"t":"A：image[cur.r+1][cur.c] = new_color"}]},{"key":"B","content":[{"t":"B：image[cur.r][cur.c] = new_color"}]},{"key":"C","content":[{"t":"C：image[cur.r][cur.c+1] = new_color"}]},{"key":"D","content":[{"t":"D：image[cur.r][cur.c] = prev_color"}]}],"answer":"B","analysis":"","auto":true},{"no":8,"type":"单选题（完善程序）","stem":[{"t":"③处应填（ ）"}],"options":[{"key":"A","content":[{"t":"A：Point(pt.r, pt.c)"}]},{"key":"B","content":[{"t":"B：Point(pt.r, pt.c+1)"}]},{"key":"C","content":[{"t":"C：Point(pt.r+1, pt.c)"}]},{"key":"D","cont