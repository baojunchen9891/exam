s/content/20231127/17010709145361.png"}],"options":[{"key":"A","content":[{"t":"A：正确"}]},{"key":"B","content":[{"t":"B：错误"}]}],"answer":"A","analysis":"","auto":true},{"no":1,"type":"问答题","stem":[{"t":"密码合规检测"},{"img":"https://www.leledati.com/files/attach/files/content/20231127/17010709688023.png"},{"img":"https://www.leledati.com/files/attach/files/content/20231127/17010709783018.png"},{"t":"【题目描述】"},{"t":"网站注册需要有用户名和密码，默认小猫角色和白色背景，编写程序以检查用户输入密码的有效性。"},{"t":"（1）合法的密码只能由 a-z 之间 26 个字母（字母不区分大小写）、0-9 之间 10 个数字以及!@#$四个特殊字母构成。"},{"t":"（2）密码最短长度：6 个字符，密码最大长度：12 个字符。"},{"t":"（3）密码必须包含字母、数字和特殊字符，缺一不可。"},{"t":"【输入描述】"},{"t":"新建变量“lst”，用于存储待检测的密码。"},{"t":"如下图所示："},{"img":"https://www.leledati.com/files/attach/files/content/20231127/17010710512702.png"},{"t":"【输出描述】"},{"t":"新建列表“result”，用于存储合规的密码，存入顺序以“lst”列表中字符串的先后为序。"},{"t":"如下图所示："},{"img":"https://www.leledati.com/files/attach/files/content/20231127/17010710633297.png"},{"t":"【输入样例1】"},{"t":"lst = [seHJ12!@, sjdkffH$123, sdf!@^&12 HDH, 123&^YUhg@!]"},{"t":"【输出样例1】"},{"t":"result = [seHJ12!@, sjdkffH$123]"},{"t":"【输入样例2】"},{"t":"lst = [123!@#&^%ZAqaz, abc123ABC!@#, qaz123WSX!@#, 12QAqa!@, 12QAqa!@^&]"},{"t":"【输出样例2】"},{"t":"result = [abc123ABC!@#, qaz123WSX!@#, 12QAqa!@]"}],"options":[],"answer":null,"analysis":"【评分标准】 一共 5 组测试用例，通过一组测试用例得 5 分。 测试用例 1： lst = [abcq313QAX!@, qaz123!@#QAZ, 123!!XYZxyz@@, 123!@#&^%ZAqaz, 12QAqa!@^&]； result = [abcq313QAX!@, qaz123!@#QAZ] 测试用例 2： lst = [abcq313QAX!@, helpCCF9!@#$, try!#!#TRY147]； result = [abcq313QAX!@, helpCCF9!@#$] 测试用例 3： lst = [147WRwr!@#,qaz123!@#QAZ,123XYZxyz@@,!@#$%12345qQ]； result = [147WRwr!@#, qaz123!@#QAZ, 123XYZxyz@@] 测试用例 4： lst = [258DHZdhz#@!, qaz&^123!@#QAZ, 123!!XYZxyz@@, !@#$%12345qQ]； result = [258DHZdhz#@!] 测试用例 5： lst = [!@#$%12345qQ, 123XYZxyz@@, helpCCF9!@#$, 123!@#&^%ZAqaz]； result = [123XYZxyz@@, helpCCF9!@#$]","auto":false},{"no":2,"type":"问答题","stem":[{"t":"按身高排序"},{"img":"https://www.leledati.com/files/attach/files/content/20231127/17010713744318.png"},{"img":"https://www.leledati.com/files/attach/files/content/20231127/17010713859796.png"},{"t":"【题目描述】"},{"t":"默认小猫角色和白色背景。有两个列表，第一个列表“names”存储名字，第二个列表“heights”存储这组名字对应的身高，这些身高由互不相同的正整数组成。"},{"t":"请按身高由大到小排序，同时能够得到对应名字的列表“names”。"},{"t":"例如："},{"t":"名字列表：names = [‘Emily’,’Michael’,’Sarah’]"},{"t":"身高列表：heights = [180,165,170]"},{"t":"按照身高由大到小排序后，Emily 最高，接着是 Sarah 和 Michael"},{"t":"最后得到的名字列 heights = [‘Emily’,’Sarah’,’Michael’]"},{"t":"【输入描述】"},{"t":"新建两个列表，“names”存储一组姓名，“heights”存储这组姓名对应的身高，这些身高是互不相同的正整数。"},{"t":"如下图所示："},{"img":"https://www.leledati.com/files/attach/files/content/20231127/17010714545675.png"},{"t":"【输出描述】"},{"t":"无需新建，仍用以前的列表“names”，存储按照身高由大到小排序后，对应的姓名。"},{"t":"如下图所示："},{"img":"https://www.leledati.com/files/attach/files/content/20231127/17010714675129.png"},{"t":"【输入样例1】"},{"t":"names = [‘Emily’,’Michael’,’Sarah’]\r\nheights = [180,165,170]"},{"t":"【输出样例1】"},{"t":"names = [‘Emily’,’Sarah’,’Michael’]"},{"t":"【输入样例2】"},{"t":"names = [‘Mary’,’John’,’Emma’,’Tom’]\r\nheights = [160,180,170,157]"},{"t":"【输出样例2】"},{"t":"names = [’John’,’Emma’,’Mary’,’Tom’]"}],"options":[],"answer":null,"analysis":"【评分标准】 一共 5 组测试用例，通过一组测试用例得 5 分。 测试用例 1： names = [‘Alice’,’Bob’,’Tom’]，heights = [155,185,150]； names = [’Bob’,‘Alice’,’Tom’] 测试用例 2： names = [‘Nicholas’, ‘Abigail’, ‘Benjamin’, ‘Elizabeth’] ， heights = [160,175,158,180]； names = [‘Elizabeth’,‘Abigail’,‘Nicholas’,‘Benjamin’] 测试用例 3： names = [‘William’,‘Olivia’, ‘James’,’Sarah’,’Nicholas’]， heights = [174, 160, 178, 158, 180]； names = [’Nicholas’,‘James’, ‘William’, ‘Olivia’, ’Sarah’] 测试用例 4： names = [‘Olivia’, ‘William’]，heights = [178,180]； names = [‘William’, ‘Olivia’] 测试用例 5： names = [‘Emily’]，heights = [175]； names = [‘Emily’]","auto":false}],"durationMin":60,"totalScore":100,"passScore":60,"source":"leledati","tags":{"year":"2023","type":"真题","progress":"未开始"}}