n(f[x][y], dfs(x, b) + 1);"},{"t":"f[x][y] = min(f[x][y], dfs(0, y) + 1);"},{"t":"f[x][y] = min(f[x][y], dfs(x, 0) + 1);"},{"t":"int t = min(a - x, y);"},{"t":"f[x][y] = min(f[x][y],      ①     );"},{"t":"t = min(x, b - y);"},{"t":"f[x][y] = min(f[x][y],      ②     );"},{"t":"return f[x][y];"},{"t":"}"},{"t":"void go(int x, int y) {"},{"t":"if (     ③     )"},{"t":"return;"},{"t":"if (f[x][y] == dfs(a, y) + 1) {"},{"t":"cout << \"FILL(1)\" << endl;"},{"t":"go(a, y);"},{"t":"} else if (f[x][y] == dfs(x, b) + 1) {"},{"t":"cout << \"FILL(2)\" << endl;"},{"t":"go(x, b);"},{"t":"} else if (f[x][y] == dfs(0, y) + 1) {"},{"t":"cout << \"DROP(1)\" << endl;"},{"t":"go(0, y);"},{"t":"} else if (f[x][y] == dfs(x, 0) + 1) {"},{"t":"cout << \"DROP(2)\" << endl;"},{"t":"go(x, 0);"},{"t":"} else {"},{"t":"int t = min(a - x, y);"},{"t":"if (f[x][y] ==      ④     ) {"},{"t":"cout << \"POUR(2,1)\" << endl;"},{"t":"go(x + t, y - t);"},{"t":"} else {"},{"t":"t = min(x, b - y);"},{"t":"if (f[x][y] ==      ⑤     ) {"},{"t":"cout << \"POUR(1,2)\" << endl;"},{"t":"go(x - t, y + t);"},{"t":"} else"},{"t":"assert(0);"},{"t":"}"},{"t":"}"},{"t":"}"},{"t":"int main() {"},{"t":"cin >> a >> b >> c;"},{"t":"ans = 1 << 30;"},{"t":"memset(f, 127, sizeof f);"},{"t":"init = **f;"},{"t":"if ((ans = dfs(0, 0)) == init - 1)"},{"t":"cout << \"impossible\";"},{"t":"else {"},{"t":"cout << ans << endl;"},{"t":"go(0, 0);"},{"t":"}"},{"t":"}"}],"options":[{"key":"A","content":[{"t":"A：dfs(x + t, y - t) + 1"}]},{"key":"B","content":[{"t":"B：dfs(x + t, y - t) - 1"}]},{"key":"C","content":[{"t":"C：dfs(x - t, y + t) + 1"}]},{"key":"D","content":[{"t":"D：dfs(x - t, y + t) - 1"}]}],"answer":"A","analysis":"","auto":true},{"no":7,"type":"单选题（完善程序）","stem":[{"t":"②处应填（ ）"}],"options":[{"key":"A","content":[{"t":"A：dfs(x + t, y - t) + 1"}]},{"key":"B","content":[{"t":"B：dfs(x + t, y - t) - 1"}]},{"key":"C","content":[{"t":"C：dfs(x - t, y + t) + 1"}]},{"key":"D","content":[{"t":"D：dfs(x - t, y + t) - 1"}]}],"answer":"C