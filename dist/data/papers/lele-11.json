":"A","content":[{"t":"A：10"}]},{"key":"B","content":[{"t":"B：9"}]},{"key":"C","content":[{"t":"C：12"}]},{"key":"D","content":[{"t":"D：11"}]}],"answer":"D","analysis":"","auto":true},{"no":18,"type":"单选题","stem":[{"t":"默认小猫角色，执行以下程序，舞台上会出现？"},{"img":"https://www.leledati.com/files/attach/files/content/20221009/16653016936070.png"}],"options":[{"key":"A","content":[{"t":"A：黑色的三角形"}]},{"key":"B","content":[{"t":"B：黑色的正方形"}]},{"key":"C","content":[{"t":"C：黑色的长方形"}]},{"key":"D","content":[{"t":"D：没有任何图形"}]}],"answer":"D","analysis":"","auto":true},{"no":19,"type":"单选题","stem":[{"t":"执行以下程序，舞台上会看到几只小猫？"},{"img":"https://www.leledati.com/files/attach/files/content/20221009/16653018158155.png"}],"options":[{"key":"A","content":[{"t":"A：2只小猫"}]},{"key":"B","content":[{"t":"B：3只小猫"}]},{"key":"C","content":[{"t":"C：1只小猫"}]},{"key":"D","content":[{"t":"D：0只小猫"}]}],"answer":"A","analysis":"","auto":true},{"no":20,"type":"单选题","stem":[{"t":"小猫角色有两个造型：造型1、造型2，程序运行前造型为造型1，点击一次绿旗，说法正确的是？"},{"img":"https://www.leledati.com/files/attach/files/content/20221009/16653019264120.png"}],"options":[{"key":"A","content":[{"t":"A：小猫从造型1变成造型2"}]},{"key":"B","content":[{"t":"B：小猫可能一直是造型2，也可能是从造型1变成造型2"}]},{"key":"C","content":[{"t":"C：小猫一直是造型1"}]},{"key":"D","content":[{"t":"D：小猫一直是造型2"}]}],"answer":"A","analysis":"","auto":true},{"no":21,"type":"单选题","stem":[{"t":"运行下面程序，最终小猫说的内容是？"},{"img":"https://www.leledati.com/files/attach/files/content/20221009/16653021398355.png"}],"options":[{"key":"A","content":[{"t":"A：1"}]},{"key":"B","content":[{"t":"B：2"}]},{"key":"C","content":[{"t":"C：0"}]},{"key":"D","content":[{"t":"D：3"}]}],"answer":"B","analysis":"","auto":true},{"no":22,"type":"单选题","stem":[{"t":"关于下面积木，正确选项是？"},{"img":"https://www.leledati.com/files/attach/files/content/20221009/16653023644053.png"}],"options":[{"key":"A","content":[{"t":"A：最大值是20"}]},{"key":"B","content":[{"t":"B：最大值是25"}]},{"key":"C","content":[{"t":"C：最小值是0"}]},{"key":"D","content":[{"t":"D：最小值是5"}]}],"answer":"B","ana