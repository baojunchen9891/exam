25133.png"}]}],"answer":"B","analysis":"并且用与积木，B答案正确。","auto":true},{"no":15,"type":"单选题","stem":[{"t":"下列积木的结果是？（ ）"},{"img":"assets/images/17796160568513.png"}],"options":[{"key":"A","content":[{"t":"false"}]},{"key":"B","content":[{"t":"true"}]},{"key":"C","content":[{"t":"10"}]},{"key":"D","content":[{"t":"5"}]}],"answer":"A","analysis":"10>5为真，反操作是假，选项A正确。","auto":true},{"no":16,"type":"单选题","stem":[{"t":"下列积木的结果是？（ ）"},{"img":"assets/images/17796160975049.png"}],"options":[{"key":"A","content":[{"t":"中2"}]},{"key":"B","content":[{"t":"2026中国"}]},{"key":"C","content":[{"t":"中国 2026"}]},{"key":"D","content":[{"t":"中国2026"}]}],"answer":"D","analysis":"把两个字符串连接起来，中间没有空格、","auto":true},{"no":17,"type":"单选题","stem":[{"t":"下列哪个积木的值最小？（ ）"}],"options":[{"key":"A","content":[{"img":"assets/images/17796161713143.png"}]},{"key":"B","content":[{"img":"assets/images/17796161767472.png"}]},{"key":"C","content":[{"img":"assets/images/17796161825863.png"}]},{"key":"D","content":[{"img":"assets/images/17796161899210.png"}]}],"answer":"C","analysis":"选项A的值为：12；选项B的值为：11； 选项C的值为：4； 选项D的值为：10；所以， 值最小的选项为C。","auto":true},{"no":18,"type":"单选题","stem":[{"t":"下列两个积木的区别是？（ ）"},{"img":"assets/images/17796164053150.png"}],"options":[{"key":"A","content":[{"t":"没有区别"}]},{"key":"B","content":[{"t":"前者会暂停程序直到声音放完，后者会边放声音边执行下面积木"}]},{"key":"C","content":[{"t":"前者声音大，后者声音小"}]},{"key":"D","content":[{"t":"前者只能播放一次，后者循环播放"}]}],"answer":"B","analysis":"通过积木的字面意思推导出B选项正确。","auto":true},{"no":19,"type":"单选题","stem":[{"t":"根据圆的虚实规律，最后一个位置有几个实心圆？（ ）"},{"t":"行 1：○●○"},{"t":"行 2：○●○●○"},{"t":"行 3：○●○●○●○"},{"t":"行 4：？（实心圆数量）"}],"options":[{"key":"A","content":[{"t":"3"}]},{"key":"B","content":[{"t":"4"}]},{"key":"C","content":[{"t":"5"}]},{"key":"D","content":[{"t":"6"}]}],"answer":"B","analysis":"第n行有n个实心圆，行4有4个。","auto":true},{"no":20,"type":"单选题","stem":[{"t":"如下图所示，第一行1个小正方形，第二行4个小正方形，第三行9个小正方形，第四行应该有几个小正方形？（ ）"},{"img":"assets/images/17796165433067.png"}],"options":[{"key":"A","content":[{"t":"1